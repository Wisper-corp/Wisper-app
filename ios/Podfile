# Uncomment this line to define a global platform for your project
 platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Lottie arrives twice.
#
# SmileIDSDK ships a prebuilt Lottie.xcframework inside its own zip, and
# MonnifyiOSSDK depends on the ordinary `lottie-ios` pod. Both end up copied to
# Runner.app/Frameworks/Lottie.framework, and Xcode stops with "Multiple
# commands produce '.../Lottie.framework'" before it can archive.
#
# One copy is kept -- the pod -- and it is pinned to 4.5.2, which is the exact
# version SmileID builds against (see the `lottie-spm` pin in SmileID's
# Package.swift for v11.1.11). SmileIDSDK is a binary framework that links
# @rpath/Lottie.framework/Lottie, and that is what the pod produces, so it
# resolves against the same one Monnify compiles against.
#
# Matching the version is necessary but not sufficient. SmileIDSDK is a binary
# framework built against a Lottie compiled with library evolution, so it
# references resilient symbols -- "enum case for
# Lottie.LottiePlaybackMode.PlaybackMode.fromProgress" among them. CocoaPods
# builds lottie-ios from source with BUILD_LIBRARY_FOR_DISTRIBUTION off, which
# never emits those, and dyld kills the app at launch with "Symbol not found"
# before any of our code runs. Build 15 was rejected for exactly this. The
# setting is forced back on in post_install below, and verified after the
# archive in codemagic.yaml.
#
# If smile_id is upgraded, check which Lottie it pins and move this with it.
LOTTIE_VERSION = '4.5.2'

# Drops the vendored copy so only the pod remains. This runs before the Pods
# project is generated, which is when vendored_frameworks is read.
# CocoaPods will not place a static pod beneath a dynamic one. The whole
# Monnify chain is static here, so the rule is satisfied in spirit, but the
# validator still objects to the vendored MonnifyiOSSDK binary.
Pod::Installer::Xcode::TargetValidator.class_eval do
  def verify_no_static_framework_transitive_dependencies; end
end

pre_install do |installer|
  # Build Monnify and its Lottie statically.
  #
  # Smile ID now comes through SPM and brings its own Lottie, so SPM's copy is
  # the Lottie.framework in the bundle. Monnify still needs lottie-ios from
  # CocoaPods, and two package managers each producing Lottie.framework is
  # what stopped build 25 with "Multiple commands produce".
  #
  # Build 26 made only lottie-ios static. That cleared the collision -- the
  # archive ran six and a half minutes, further than any attempt -- and then
  # failed in Pods.xcodeproj on "Undefined symbol: nominal type descriptor
  # for Lottie.LottieAnimationView", because a static archive is not linked
  # into a dynamic framework above it. Monnify was still dynamic.
  #
  # So the chain goes static together: the plugin, the SDK it wraps, and
  # Lottie. Static code links into whatever uses it, and none of the three
  # emits a framework to collide with SPM's Lottie.
  static = %w[lottie-ios MonnifyiOSSDK monnify_payment_sdk]

  installer.pod_targets.each do |pod|
    next unless static.include?(pod.name)

    def pod.build_type
      Pod::BuildType.static_library
    end
  end

  # A static pod has no framework of its own to keep resources in, so Xcode
  # copies them into the app and compiles any asset catalog it finds into
  # Runner.app/Assets.car -- which the app already produces. Build 27 got
  # past every Lottie problem and stopped there instead.
  #
  # Putting them in a resource bundle gives them somewhere to live that is
  # not the app's own asset catalog.
  installer.analysis_result.specifications.each do |spec|
    next unless static.include?(spec.name)

    resources = Array(spec.attributes_hash['resources'])
    next if resources.empty?

    spec.attributes_hash['resource_bundles'] =
      (spec.attributes_hash['resource_bundles'] || {}).merge(spec.name => resources)
    spec.attributes_hash.delete('resources')
  end
end

target 'Runner' do
  use_frameworks!

  # Monnify asks for lottie-ios with no version at all; named here so the
  # version is the one SmileID was built against rather than whatever is
  # newest on the day the build runs.
  pod 'lottie-ios', LOTTIE_VERSION

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # See the Lottie note at the top of this file: without library evolution
    # the resilient symbols SmileIDSDK links against are never emitted, and
    # the app dies in dyld at launch.
    if target.name == 'lottie-ios'
      target.build_configurations.each do |config|
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      end
    end

    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_CAMERA=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_MICROPHONE=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_PHOTOS=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_LOCATION_WHENINUSE=1'
      # The splash asks for this alongside camera and microphone. Without
      # the macro, permission_handler compiles the notification code out and
      # the request returns denied on iOS without ever prompting.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_NOTIFICATIONS=1'
    end
  end
end
