# Uncomment this line to define a global platform for your project
 platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Lottie arrives twice.
#
# SmileIDSDK ships a prebuilt Lottie.xcframework inside its own zip, and
# MonnifyiOSSDK depends on the ordinary `lottie-ios` pod. Both end up copied to
# Runner.app/Frameworks/Lottie.framework, and Xcode stops with "Multiple
# commands produce '.../Lottie.framework'" before it can archive.
#
# The copy that is kept must be SmileIDSDK's. It is a binary framework linked
# against a Lottie that exports two Swift runtime back-compatibility hooks:
#
#     _swiftoverride_class_getSuperclass              (Swift 5.0)
#     swift51override_conformsToSwiftProtocol         (Swift 5.1)
#
# A Lottie that CocoaPods builds from source never exports those. They live in
# libswiftCompatibility50/51.a, which Xcode links only below iOS 12.2 and 13.0,
# and the symbols are private there in any case. Builds 18 and 19 tried a lower
# deployment target -- Lottie's SwiftUI sources will not compile below 13 --
# and -force_load, which linked them without exporting them. Build 20 upgraded
# SmileID to 11.2.3 on the chance the newer binary had dropped the
# requirement; it had not.
#
# So Monnify loses its lottie-ios dependency and links the vendored copy. Both
# want 4.5.2, the version SmileID pins, so Monnify gets what it expects.
#
# codemagic.yaml checks the archive for exactly this before it ships.

# Drops the vendored copy so only the pod remains. This runs before the Pods
# project is generated, which is when vendored_frameworks is read.
# Pinned to what SmileID builds against, so Monnify compiles against the same
# Lottie the vendored framework provides. Left unpinned it drifted to 4.6.1.
LOTTIE_VERSION = '4.5.2'

pre_install do |installer|
  # Build lottie-ios statically so it never becomes a second
  # Lottie.framework.
  #
  # SmileIDSDK's vendored Lottie has to be the one in the bundle -- see the
  # note above -- but Monnify depends on the lottie-ios pod and that
  # dependency cannot simply be removed: pre_install runs after CocoaPods has
  # already resolved the graph, so deleting it from the spec changes nothing.
  # Build 21 proved that, and also drifted the version once the explicit pin
  # went away.
  #
  # Static linkage keeps the pod and removes the collision. Monnify gets
  # Lottie's code compiled into it, nothing is copied to
  # Runner.app/Frameworks/Lottie.framework from the pod, and SmileIDSDK
  # resolves @rpath/Lottie.framework/Lottie against the vendored copy that
  # exports the Swift runtime hooks it needs.
  installer.pod_targets.each do |pod|
    next unless pod.name == 'lottie-ios'

    def pod.build_type
      Pod::BuildType.static_library
    end
  end
end

target 'Runner' do
  use_frameworks!

  # Monnify asks for lottie-ios with no version; pinned so it matches the
  # vendored Lottie. Built statically in pre_install so it does not collide.
  pod 'lottie-ios', LOTTIE_VERSION

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_CAMERA=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_MICROPHONE=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_PHOTOS=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_LOCATION_WHENINUSE=1'
      # The splash asks for this alongside camera and microphone. Without
      # the macro, permission_handler compiles the notification code out and
      # the request returns denied on iOS without ever prompting.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_NOTIFICATIONS=1'
    end
  end
end
