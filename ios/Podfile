# Uncomment this line to define a global platform for your project
 platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Lottie arrives twice.
#
# SmileIDSDK ships a prebuilt Lottie.xcframework inside its own zip, and
# MonnifyiOSSDK depends on the ordinary `lottie-ios` pod. Both end up copied to
# Runner.app/Frameworks/Lottie.framework, and Xcode stops with "Multiple
# commands produce '.../Lottie.framework'" before it can archive.
#
# The copy that is kept must be SmileIDSDK's. It is a binary framework linked
# against a Lottie that exports two Swift runtime back-compatibility hooks:
#
#     _swiftoverride_class_getSuperclass              (Swift 5.0)
#     swift51override_conformsToSwiftProtocol         (Swift 5.1)
#
# A Lottie that CocoaPods builds from source never exports those. They live in
# libswiftCompatibility50/51.a, which Xcode links only below iOS 12.2 and 13.0,
# and the symbols are private there in any case. Builds 18 and 19 tried a lower
# deployment target -- Lottie's SwiftUI sources will not compile below 13 --
# and -force_load, which linked them without exporting them. Build 20 upgraded
# SmileID to 11.2.3 on the chance the newer binary had dropped the
# requirement; it had not.
#
# So Monnify loses its lottie-ios dependency and links the vendored copy. Both
# want 4.5.2, the version SmileID pins, so Monnify gets what it expects.
#
# codemagic.yaml checks the archive for exactly this before it ships.

# Drops the vendored copy so only the pod remains. This runs before the Pods
# project is generated, which is when vendored_frameworks is read.
pre_install do |installer|
  installer.analysis_result.specifications.each do |spec|
    # Keep SmileIDSDK's own Lottie and take lottie-ios out of Monnify instead.
    #
    # It was the other way round until now: the vendored copy was dropped and
    # everything pointed at the pod. That cannot work. SmileIDSDK is a binary
    # framework whose Lottie exports two Swift runtime back-compatibility
    # hooks -- swiftoverride_class_getSuperclass and
    # swift51override_conformsToSwiftProtocol -- and a Lottie built from
    # source never exports them: they are private inside the compatibility
    # archives. Builds 18 and 19 tried a lower deployment target and
    # -force_load and failed identically, and upgrading SmileID to 11.2.3 in
    # build 20 did not drop the requirement either.
    #
    # Only one Lottie may reach Runner.app/Frameworks or Xcode stops with
    # "Multiple commands produce Lottie.framework", so Monnify loses its
    # dependency and links the vendored one. Both want 4.5.2, which is what
    # SmileID pins, so Monnify compiles against the version it expects.
    if spec.name == 'MonnifyiOSSDK'
      spec.attributes_hash['dependencies']&.delete('lottie-ios')
    end
  end
end

target 'Runner' do
  use_frameworks!

  # No lottie-ios pod: SmileIDSDK vendors the Lottie everything links
  # against. See the pre_install note above.

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_CAMERA=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_MICROPHONE=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_PHOTOS=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_LOCATION_WHENINUSE=1'
      # The splash asks for this alongside camera and microphone. Without
      # the macro, permission_handler compiles the notification code out and
      # the request returns denied on iOS without ever prompting.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_NOTIFICATIONS=1'
    end
  end
end
